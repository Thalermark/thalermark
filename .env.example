# =============================================================================
# Thalermark — environment template
# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# =============================================================================

# ---- Node environment ------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- Database --------------------------------------------------------------
# PostgreSQL 17 with the pgvector extension.
DATABASE_URL=postgres://thalermark:thalermark@localhost:5432/thalermark

# ---- Auth (Better Auth) ----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- LLM (Vercel AI SDK) ---------------------------------------------------
# Provider: anthropic (default) | openai | ollama
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional overrides — leave blank to use sensible defaults per provider.
LLM_MODEL_REASONING=
LLM_MODEL_FAST=
# For ollama only
OLLAMA_BASE_URL=http://localhost:11434

# ---- Email -----------------------------------------------------------------
# SaaS default: Resend. Self-host: leave RESEND_API_KEY empty and configure SMTP.
RESEND_API_KEY=
EMAIL_FROM=Thalermark <hello@thalermark.com>

# SMTP fallback for self-host
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---- Object storage --------------------------------------------------------
# S3-compatible. SaaS: Cloudflare R2. Dev: MinIO (in compose). Tiny self-host: local FS.
# Set STORAGE_DRIVER=local to use the filesystem adapter instead.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=thalermark
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Local filesystem adapter (when STORAGE_DRIVER=local)
STORAGE_LOCAL_PATH=./data/storage

# ---- Payments (Stripe) -----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Address autocomplete --------------------------------------------------
# Provider: mapbox (default) | nominatim
LOCATION_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
# Optional self-hosted Nominatim base URL; leave blank to use public OSM (rate-limited).
NOMINATIM_BASE_URL=

# ---- Telemetry -------------------------------------------------------------
# Opt-in only. Default off. See TELEMETRY.md for the full spec.
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=https://telemetry.thalermark.com/v1/events
TELEMETRY_INSTANCE_ID=

# ---- Public URLs -----------------------------------------------------------
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
