# =============================================================================
# Thalermark — environment template
# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# =============================================================================

# ---- Node environment ------------------------------------------------------
NODE_ENV=development
# debug | info | warning | error | fatal. Default info.
LOG_LEVEL=info
# Optional: surfaced in error tracking + structured logs as a release marker.
# Set this in deploy pipelines to the git SHA or release tag.
RELEASE=

# ---- API server ------------------------------------------------------------
# Port for the Hono API. Defaults to 3000 if unset.
API_PORT=3000

# ---- Error tracking --------------------------------------------------------
# Sentry-compatible DSN (SaaS Sentry or self-hosted GlitchTip both work).
# Leave blank to disable error tracking entirely (the SDK is loaded but inert).
ERROR_TRACKING_DSN=

# ---- Database --------------------------------------------------------------
# PostgreSQL 17 with the pgvector extension. The api uses two connection
# strings:
#
#   DATABASE_URL      — superuser. Used for DDL only (migrations, plus the
#                       boot-time ALTER ROLE that gives thalermark_app a
#                       password). Not used for runtime traffic.
#   APP_DATABASE_URL  — runtime traffic. Must point at the non-BYPASSRLS
#                       thalermark_app role (created in migration 0005) so
#                       RLS policies actually fire as the primary tenancy
#                       fence (the explicit account_id filter in every API
#                       SELECT is the second).
#   PGBOSS_DATABASE_URL — background-job queue. Points at the dedicated, least-
#                       privilege thalermark_pgboss role (migration 0052) so the
#                       job runner holds no superuser creds at runtime. Optional:
#                       falls back to DATABASE_URL (the old behaviour) when unset.
#
# Self-host (docker compose) sets all from POSTGRES_* + THALERMARK_APP_PASSWORD
# + THALERMARK_PGBOSS_PASSWORD.
#
# The credentials in this file are intentional, NON-SECRET local-dev defaults — safe to
# commit; the bundled docker compose works with them out of the box. Change every password
# (POSTGRES_PASSWORD, THALERMARK_APP_PASSWORD, BETTER_AUTH_SECRET, STORAGE_URL_SECRET, …)
# for any real deploy. They are example/dev values, not leaked secrets (see .gitguardian.yaml).
DATABASE_URL=postgres://thalermark:thalermark@localhost:5432/thalermark
APP_DATABASE_URL=postgres://thalermark_app:thalermark_app@localhost:5432/thalermark
# When set, the api at boot runs `ALTER ROLE thalermark_app WITH LOGIN
# PASSWORD <this>` against DATABASE_URL — idempotent, so rotating the secret
# is just a redeploy. Leave blank if the role is provisioned out-of-band
# (managed Postgres, external migration step); the operator then owns the
# credentials and APP_DATABASE_URL must already match.
THALERMARK_APP_PASSWORD=thalermark_app
# Background-job (pg-boss) connection + its role password. Optional: leave both
# blank to keep pg-boss on the superuser DATABASE_URL (the old behaviour). To run
# pg-boss on its own least-privilege role, point PGBOSS_DATABASE_URL at
# thalermark_pgboss and set THALERMARK_PGBOSS_PASSWORD — the api then runs
# `ALTER ROLE thalermark_pgboss WITH LOGIN PASSWORD <this>` at boot (idempotent,
# rotate by redeploy), exactly like the app role above.
PGBOSS_DATABASE_URL=postgres://thalermark_pgboss:thalermark_pgboss@localhost:5432/thalermark
THALERMARK_PGBOSS_PASSWORD=thalermark_pgboss
# Max connections per runtime pool. The api opens two (tenant + bootstrap), so
# the live connection count is up to 2×this plus pg-boss — keep the total under
# the server's max_connections. Defaults to 10; raise for a bigger box. The
# accompanying pool timeouts (connection / statement / idle-in-transaction) are
# fixed safety rails in the api, not env-tunable.
DB_POOL_MAX=10
# Run drizzle migrations during api startup. Self-host docker-compose
# convenience; production deploys usually want a dedicated migrate step
# ahead of the rollout. Accepts 'true' or '1'.
MIGRATE_ON_BOOT=false

# ---- Auth (Better Auth) ----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# Dev (pnpm dev): http://localhost:3000
# Self-host (docker compose): docker-compose.yml overrides this to
# https://${THALERMARK_DOMAIN} so BA generates HTTPS cookies and redirects.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated origin allowlist. Used by Better Auth (CSRF check on auth
# endpoints) AND Hono's cors middleware (RPC endpoints with credentials).
# Browser sign-up/in fails without this; curl bypasses CORS so it's a footgun.
# `thalermark://` is the Expo app scheme — mobile sends it as a synthetic
# Origin so BA's CSRF middleware has something to validate against.
# Self-host (docker compose) overrides this to include https://${THALERMARK_DOMAIN}.
TRUSTED_ORIGINS=http://localhost:5173,thalermark://

# Request rate limiting. Gates BOTH Better Auth's credential-endpoint limiter
# and the app-level limiter on the expensive routes (AI/LLM calls, invoice +
# estimate email sends, the public payment-intent mint). Counters are stored in
# Postgres (auth_rate_limit / app_rate_limit), so they survive redeploys and are
# shared across instances. Defaults to ON in production, OFF elsewhere; set to
# 'true' to exercise it locally, 'false' to force it off in production.
RATE_LIMIT_ENABLED=

# Optional social sign-in. Set BOTH halves of a provider to enable its button;
# leave blank for email/password only. The api reports configured providers to
# the web sign-in page (GET /api/social-providers) — no separate web flag.
# For each, register this exact authorized redirect URI on the provider's OAuth
# app:  ${BETTER_AUTH_URL}/api/auth/callback/<provider>
#   dev → http://localhost:3000/api/auth/callback/{google,facebook,twitter}
# Also ensure the web origin(s) in TRUSTED_ORIGINS are allow-listed (Better Auth
# validates the post-login callbackURL against them).
#
# Google — Google Cloud Console → APIs & Services → Credentials → OAuth client
#          (Web application). Callback: .../api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook — developers.facebook.com app → Facebook Login. clientId = App ID,
#            secret = App Secret. Must request the `email` permission/scope, and
#            list the callback under Valid OAuth Redirect URIs (.../callback/facebook).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# X (Twitter) — developer.x.com app with OAuth 2.0 (Confidential client). Better
#               Auth's provider key is `twitter`. Callback: .../api/auth/callback/twitter.
#               Request email access so invited-by-email joins work.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Email verification on email/password signup. Unset (default) = ON only when a
# real mailer is configured (RESEND_API_KEY below), so a self-host install
# without email isn't locked out and SaaS gets it automatically. Set =true to
# force it (dev testing with the console mailer prints the verify link to the
# api logs; or a self-host using SMTP); =false to disable.
REQUIRE_EMAIL_VERIFICATION=

# ---- LLM (Vercel AI SDK) ---------------------------------------------------
# Powers receipt extraction (auto-fill from a photo/PDF), expense categorization,
# and cash-flow nudges. Provider: anthropic (default) | openai | ollama
# anthropic/openai need LLM_API_KEY; leaving it blank disables AI features (the
# AI endpoints 503, the rest of the app runs). ollama needs no key — the no-cost
# self-host path.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Per-role model overrides — leave blank for sensible per-provider defaults.
# Roles map by task, not vendor: vision reads images (receipt extraction),
# reasoning is the heavier interpretation pass (cash-flow nudges), fast is cheap
# text (expense categorization). On cloud providers one multimodal model serves
# every role, so these stay blank; the split matters for ollama, where vision
# and text are separate models and the bigger reasoning model is worth it:
#   LLM_MODEL_VISION=llama3.2-vision   (or granite3.2-vision, minicpm-v, llava)
#   LLM_MODEL_REASONING=qwen2.5:14b
#   LLM_MODEL_FAST=llama3.2
LLM_MODEL_VISION=
LLM_MODEL_REASONING=
LLM_MODEL_FAST=
# For ollama only.
OLLAMA_BASE_URL=http://localhost:11434

# ---- Email -----------------------------------------------------------------
# SaaS default: Resend. Self-host: leave RESEND_API_KEY empty and configure SMTP.
RESEND_API_KEY=
EMAIL_FROM=Thalermark <hello@thalermark.com>

# SMTP fallback for self-host
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---- Background jobs (pg-boss) ---------------------------------------------
# The recurring-invoice sweep runs on this cron (UTC). Default: 06:00 daily.
# pg-boss connects on PGBOSS_DATABASE_URL (the dedicated thalermark_pgboss role,
# or the superuser DATABASE_URL fallback) and manages its own `pgboss` schema.
RECURRING_SWEEP_CRON=0 6 * * *

# ---- Object storage --------------------------------------------------------
# Where receipt images live. Drivers: s3 (S3-compatible — SaaS uses Cloudflare
# R2; dev uses MinIO via docker-compose.dev.yml) and local (the api container's
# own disk). The values below target dev MinIO. The self-host bundle
# (docker/docker-compose.yml) OVERRIDES STORAGE_DRIVER to `local` and mounts a
# persistent volume, so a single `docker compose up` needs no object store —
# just set STORAGE_URL_SECRET below. R2/S3 is the option for multi-node or
# large self-host deployments (see the deployment docs' "Storage options").
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=thalermark
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Local filesystem adapter (when STORAGE_DRIVER=local)
STORAGE_LOCAL_PATH=./data/storage
# HMAC secret signing the /api/files/<token> download URLs the local adapter
# hands out (the object store has no presigning of its own). REQUIRED for the
# self-host compose (it runs STORAGE_DRIVER=local); without it the app still
# boots but receipt capture returns 503. Must be unpredictable — these tokens
# are the only thing gating public receipt reads. Generate: openssl rand -hex 32
STORAGE_URL_SECRET=

# ---- Payments (Stripe) -----------------------------------------------------
# Wires the Pay button on the public invoice view (/i/[token]) — Embedded
# Checkout, money flows via stripe.js + the /api/webhooks/stripe callback.
# All three must be set for Stripe to be active; leaving any blank hides
# Pay and 503s the webhook (dev / self-host runnable without an account).
#
# Test keys at https://dashboard.stripe.com/test/apikeys.
#
# Local dev: install the Stripe CLI and run
#   stripe listen --forward-to http://localhost:3000/api/webhooks/stripe
# It prints a `whsec_...` to drop into STRIPE_WEBHOOK_SECRET. Then trigger
# a fake event with
#   stripe trigger checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Address autocomplete --------------------------------------------------
# Consumed by the WEB app. In self-host these flow to the web service via
# docker/docker-compose.yml; for `pnpm dev` they must be set in apps/web/.env.
# Provider auto-selects: mapbox when a token is set, else the free keyless US
# Census geocoder (census). Force one with LOCATION_PROVIDER=mapbox|census|nominatim.
# LOCATION_PROVIDER=
MAPBOX_ACCESS_TOKEN=
# Only used when LOCATION_PROVIDER=nominatim; blank = public OSM (rate-limited).
NOMINATIM_BASE_URL=

# ---- Telemetry -------------------------------------------------------------
# Two-key model: the deployment-wide transport switch AND the per-account
# opt-in (accounts.telemetry_enabled) must both be true for events to leave
# this host. See TELEMETRY.md for the full spec.
#
# Self-host: leave TELEMETRY_TRANSPORT_ENABLED=false. Even if a tenant flips
# their per-account opt-in, no data leaves the host until you set this.
TELEMETRY_TRANSPORT_ENABLED=false
TELEMETRY_ENDPOINT_URL=
# Hard kill switch, independent of the keys above. Set to true to forbid
# telemetry outright: the first-run consent prompt never shows, the Settings →
# Privacy toggle is hidden/forced off, and nothing is ever staged — even for an
# account whose opt-in flag is somehow still set. Leave unset to allow opt-in.
TELEMETRY_DISABLED=
# HMAC-SHA256 shared secret for signing outbound batches. Generate with:
#   openssl rand -base64 32
TELEMETRY_SIGNING_KEY=
# Max events per HTTP call. Default 200.
TELEMETRY_BATCH_SIZE=200
# Drop an event after this many failed delivery attempts. Default 5.
TELEMETRY_RETRY_CAP=5

# ---- Public URLs -----------------------------------------------------------
# Dev: full URLs for both. Self-host (docker compose) overrides PUBLIC_API_URL
# to "" so the browser uses same-origin relative /api/* paths through Caddy.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# Web SSR (inside the web container) needs an absolute URL to reach api.
# Unset in dev (falls back to PUBLIC_API_URL); compose sets this to
# http://api:3000 so server-side fetches use the compose-internal hostname.
INTERNAL_API_URL=

# ---- Self-host (docker compose) --------------------------------------------
# Consumed by docker/docker-compose.yml + Caddyfile interpolation; not read
# by the api or web processes directly.
#
# Image tag the production compose pulls from GHCR (ghcr.io/thalermark/...).
# Defaults to `latest`; pin to a release tag (e.g. v0.1.0) or commit SHA for
# reproducible deploys. The dev stack ignores this — it builds from source.
THALERMARK_VERSION=latest
#
# Default localhost serves with Caddy's internal CA (browser warns once).
# Set to a real hostname to enable ACME via Let's Encrypt — anonymous account
# works by default; add a global `{ email you@example.com }` block to the
# Caddyfile to get renewal alerts.
THALERMARK_DOMAIN=localhost
#
# Bundled-Postgres credentials. The compose builds DATABASE_URL +
# APP_DATABASE_URL from these (plus THALERMARK_APP_PASSWORD above) and seeds the
# postgres container. Change POSTGRES_PASSWORD for any real deploy. Ignored when
# you point at a managed database instead (see DEPLOYMENT.md).
POSTGRES_USER=thalermark
POSTGRES_PASSWORD=thalermark
POSTGRES_DB=thalermark
