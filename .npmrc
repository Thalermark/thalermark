# Hoist the Expo / React Native ecosystem to the workspace root so Metro
# can resolve them under apps/mobile, which uses
# `disableHierarchicalLookup: true` (recommended by expo.fyi/monorepos to
# avoid phantom deps). Without this, every Expo/RN transitive peer dep
# (expo-modules-core, @expo/log-box, react-native-css-interop, …) shows up
# as an UnableToResolveError at bundle time.
#
# Scoped to the ecosystem so the rest of the workspace (apps/api, apps/web,
# packages/*) keeps pnpm's strict per-package resolution.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo*
public-hoist-pattern[]=react-native*
public-hoist-pattern[]=@react-native*
public-hoist-pattern[]=nativewind
public-hoist-pattern[]=react-native-css-interop
