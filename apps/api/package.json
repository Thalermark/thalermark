{
  "name": "@thalermark/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --experimental-strip-types dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hono/node-server": "1.19.13",
    "@sentry/node": "10.53.1",
    "@thalermark/logger": "workspace:*",
    "hono": "4.12.19"
  },
  "devDependencies": {
    "@types/node": "25.9.0",
    "tsx": "4.22.2",
    "vitest": "2.1.9"
  }
}
