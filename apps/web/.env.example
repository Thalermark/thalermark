PUBLIC_API_URL=http://localhost:3000

# ---- Error tracking --------------------------------------------------------
# Sentry-compatible DSN for the WEB app (SSR + browser). Self-hosted GlitchTip
# or Sentry SaaS both work. PUBLIC_-prefixed because it ships in the client
# bundle — a Sentry DSN is a write-only public key, so that's expected. Leave
# blank to disable web error tracking entirely (the SDK loads but stays inert).
# This is separate from the api's ERROR_TRACKING_DSN (root .env); set both to
# capture server + web. Point them at the same GlitchTip project or two.
PUBLIC_ERROR_TRACKING_DSN=
# Optional release marker surfaced in error tracking. Set in deploy pipelines
# to the git SHA or release tag (mirrors the api's RELEASE in the root .env).
PUBLIC_RELEASE=

# ---- Address autocomplete --------------------------------------------------
# The WEB app (not the api) serves /locations/autocomplete + /locations/details,
# so its key must live HERE — SvelteKit reads $env/dynamic/private from this
# app's own .env, NOT the repo-root .env. (That mismatch is why setting this at
# the root looked like it did nothing.) Set the SAME key in the root .env so the
# api's mobile route has it too.
#
# Powered by Google Places (New). Optional: leave blank to run without
# autocomplete — the address field degrades to plain manual entry. Enable Places
# API (New) in Google Cloud, then create an API key restricted to it. The key is
# used server-side only (never shipped to the browser), so restrict it by IP.
GOOGLE_PLACES_API_KEY=

# ---- Legal consent (clickwrap) ---------------------------------------------
# URLs of a Terms of Service + Privacy Policy page. When BOTH are set, the
# sign-up form shows a required "I agree to the Terms and Privacy" checkbox that
# gates account creation on every path (email/password, social, invite). Leave
# either blank and NOTHING renders — sign-up is byte-identical to no-consent.
#
# These default to the bundled TEMPLATE pages at /legal/terms + /legal/privacy.
# THOSE ARE PLACEHOLDERS, NOT LEGAL ADVICE — before opening sign-up to real
# users, review them with counsel and edit apps/web/src/routes/legal/*, or point
# these at your own hosted pages (an absolute https:// URL works too).
PUBLIC_TERMS_URL=/legal/terms
PUBLIC_PRIVACY_URL=/legal/privacy
