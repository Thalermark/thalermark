PUBLIC_API_URL=http://localhost:3000

# ---- Error tracking --------------------------------------------------------
# Sentry-compatible DSN for the WEB app (SSR + browser). Self-hosted GlitchTip
# or Sentry SaaS both work. PUBLIC_-prefixed because it ships in the client
# bundle — a Sentry DSN is a write-only public key, so that's expected. Leave
# blank to disable web error tracking entirely (the SDK loads but stays inert).
# This is separate from the api's ERROR_TRACKING_DSN (root .env); set both to
# capture server + web. Point them at the same GlitchTip project or two.
PUBLIC_ERROR_TRACKING_DSN=
# Optional release marker surfaced in error tracking. Set in deploy pipelines
# to the git SHA or release tag (mirrors the api's RELEASE in the root .env).
PUBLIC_RELEASE=

# ---- Address autocomplete --------------------------------------------------
# The WEB app (not the api) serves /locations/autocomplete, so its provider
# config must live HERE — SvelteKit reads $env/dynamic/private from this app's
# own .env, NOT the repo-root .env. (That mismatch is why setting these at the
# root looked like it did nothing.)
#
# Provider auto-selects:
#   - mapbox  when MAPBOX_ACCESS_TOKEN is set (best typeahead + international)
#   - census  otherwise — the free, keyless US Census geocoder (default).
#             Strong US residential coverage; US-only.
# Set LOCATION_PROVIDER explicitly only to force one (mapbox | census | nominatim).
# LOCATION_PROVIDER=
MAPBOX_ACCESS_TOKEN=
# Only used when LOCATION_PROVIDER=nominatim (OSS / international self-host).
# Blank = public OpenStreetMap (rate-limited, weak on US house numbers).
NOMINATIM_BASE_URL=
