    "@thalermark/charts": "workspace:^",
    "@thalermark/location": "workspace:*",
    "@thalermark/validation": "workspace:*",
    "better-auth": "1.6.13",
    "devalue": "5.8.1",
    "fflate": "^0.8.3",
    "hono": "4.12.25",
    "papaparse": "5.5.4"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
