{
  "name": "@thalermark/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["build"],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
