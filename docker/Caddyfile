# Thalermark — self-host reverse proxy.
#
# Same-origin routing: /api/* hits the api service, everything else hits the
# web service. Web's hooks.server.ts uses PUBLIC_API_URL=/api so server-side
# fetches and browser XHR both stay on the user's origin — no CORS round trip.
#
# TLS:
#   - When THALERMARK_DOMAIN is unset (default: localhost), Caddy detects the
#     local-only host and serves with its internal CA (`tls internal`). Browser
#     will warn once; trust the cert from /data/caddy/pki to silence it.
#   - When THALERMARK_DOMAIN is a real hostname, Caddy attempts ACME via
#     HTTP-01 / TLS-ALPN-01 on ports 80/443. ACME issuance works without a
#     registered email (anonymous account); operators wanting renewal alerts
#     can add an `email` line to the global options block below.
#   - When THALERMARK_DOMAIN is a bare IP (LAN / VM self-host), Caddy serves it
#     with the internal CA too — but TLS clients send no SNI for a raw IP, so
#     `default_sni` below is what lets the handshake select a certificate.

# Global options. `default_sni` sets the server name Caddy assumes when a client
# sends no TLS SNI. Browsers and curl only send SNI for hostnames, so reaching
# the server by a bare IP address sends none — and with no name to match, Caddy
# can't select a certificate (behind Docker's port-forward it can't fall back to
# the destination IP either) and aborts the handshake with a TLS "internal
# error". Pinning the default SNI to the configured host fixes IP-based access;
# it's a no-op for the localhost default and real-domain deploys, where SNI is
# always present.
{
	default_sni {$THALERMARK_DOMAIN:localhost}
}

{$THALERMARK_DOMAIN:localhost} {
	encode zstd gzip

	# Security response headers — applied to every response (app + api + the
	# unauthenticated public invoice/pay views). These are the headers that are
	# safe to set unconditionally. The Content-Security-Policy is deliberately
	# NOT set here: it needs SvelteKit's per-request nonce (a blunt proxy header
	# would break hydration), so it lives in apps/web/svelte.config.js `csp`.
	header {
		# Force HTTPS for a year. includeSubDomains/preload are deliberately
		# omitted: they commit every subdomain to HTTPS and (preload) are hard
		# to undo. Add them once you've confirmed all subdomains are TLS-only.
		Strict-Transport-Security "max-age=31536000"
		# Stop browsers MIME-sniffing a response into something executable.
		X-Content-Type-Options "nosniff"
		# Nothing here is meant to be framed (Embedded Checkout was dropped for a
		# branded /pay route), so deny framing outright — clickjacking defense.
		X-Frame-Options "DENY"
		# Don't leak full URLs (which carry public invoice/estimate tokens) in
		# the Referer header on cross-origin navigations.
		Referrer-Policy "strict-origin-when-cross-origin"
		# The web app uses none of these browser capabilities (receipt capture is
		# the native app / a file picker, not getUserMedia; addresses autocomplete
		# via text, not navigator.geolocation).
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Don't advertise the server software/version.
		-Server
	}

	# Cap request bodies so a flood of huge uploads can't exhaust api memory.
	# The largest legitimate body is a receipt upload (RECEIPT_MAX_BYTES = 10MB
	# in apps/api/src/app.ts); 12MB leaves room for multipart boundary overhead.
	# The api still enforces its own per-asset limits (receipt 10MB, logo 2MB) —
	# this is the outer guard that rejects (413) before anything is buffered.
	request_body {
		max_size 12MB
	}

	# Content-Security-Policy is set by SvelteKit (apps/web/svelte.config.js
	# `csp`) so its per-request nonce can authorize the framework's own inline
	# scripts. Setting it here as a static header would either break hydration
	# or force 'unsafe-inline'. See that file for the directive list.

	handle /api/* {
		reverse_proxy api:3000
	}

	# Readiness, for external uptime monitoring and for the mobile app's server
	# picker (TMC-278). The api already serves /ready — `select 1` on the runtime
	# pool, raced against a short timeout, 200 or 503 — but nothing routed it, so
	# it was reachable only on the compose network. Without this handle it falls
	# through to `web`, which has no /ready route, and a monitor sits permanently
	# red. Must precede the catch-all.
	#
	# /ready NOT /health on purpose. /health is a shallow liveness probe feeding
	# the container healthcheck, where failure means "restart me" — and a restart
	# cannot fix a dead Postgres, so it stays green through a database outage and
	# is useless as an alerting signal. /ready answers the question a monitor is
	# actually asking, and a 200 from it implies liveness anyway.
	#
	# It reports database reachability to anonymous callers. That is the deliberate
	# trade for giving self-hosters any external health signal at all: before this
	# the only thing reachable from outside was the web app's HTML, which says
	# nothing about the api or the database.
	handle /ready {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3000
	}
}
