{
  "name": "thalermark",
  "version": "0.0.0",
  "private": true,
  "description": "Open source, AI-first accounting for freelancers and trades people.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://thalermark.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thalermark/thalermark.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "db:lint": "squawk packages/db/migrations/*.sql",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "drizzle-kit": "0.31.10",
    "squawk-cli": "^2.53.0",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
